# ─── Billing Portal ───

# Backend
API_PORT=3000
API_PREFIX=api

# JWT
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_EXPIRES_IN=7d

# Database (SQLite for development)
DATABASE_PATH=data/billing.sqlite

# PostgreSQL (for production — uncomment when using Neon)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Neon (optional)
# NEON_API_KEY=
# NEON_PROJECT_ID=
# NEON_BRANCH_ID=
